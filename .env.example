# ==============================================================================
# Wedding Invitation - Environment Configuration Template
# ==============================================================================
# None of these variables are mandatory; the application runs completely
# standalone with full features and local storage persistence out of the box.
# ==============================================================================

# Optional: Custom production domain URL for Open Graph & WhatsApp share previews
# Example: https://lahari-weds-shivakumar.com
VITE_PUBLIC_URL=

# Optional: Remote API or Webhook endpoint for guest RSVP submissions
# Supported services: Formspree, Google Apps Script Web App, Netlify Functions, or custom webhook
# Example: https://formspree.io/f/your_form_id
# Example: https://script.google.com/macros/s/AKfycb.../exec
VITE_RSVP_ENDPOINT=
